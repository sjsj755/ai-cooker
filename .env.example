# 复制为 .env 并按需修改；真实 .env 已加入 .gitignore，禁止入库
DATABASE_URL=mysql+pymysql://ai_cooker:ai_cooker@127.0.0.1:3306/ai_cooker
# docker compose 对外映射端口（本机 3306 被占用时改 3307 并同步 DATABASE_URL）
# MYSQL_PORT=3307

# P4 前端静态资源目录（FastAPI 同源托管；仅多端独立部署时需调整）
# FRONTEND_DIR=./frontend

# P1 采集（parse）：请求间隔对齐下厨房 robots.txt Crawl-delay=10
# CRAWLER_DELAY_SECONDS=10.0
# CRAWLER_TIMEOUT_SECONDS=10.0
# CRAWLER_RETRY=3
# CRAWL_ALLOWED_DOMAINS=["www.xiachufang.com","m.xiachufang.com"]
# CRAWLER_UA=ai-cooker-p1-bot/0.1 (+contact: dev@example.com)
# CRAWL_OUTPUT_DIR=./data/crawled
# LOG_LEVEL=INFO

# P1 ingest（入库与向量化；EMBEDDING_API_KEY 只走环境变量）
# CHROMA_DIR=./data/chroma
# CHROMA_COLLECTION=recipe_docs
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BATCH_SIZE=64
# 阿里云百炼 compatible-mode 单批上限 20，使用百炼时请设 EMBEDDING_BATCH_SIZE=20
# EMBEDDING_TIMEOUT_SECONDS=30
# 阿里云百炼示例：EMBEDDING_BASE_URL=https://<endpoint>/compatible-mode/v1、EMBEDDING_MODEL=qwen3.7-text-embedding

# P3 LLM（OpenAI 兼容：DeepSeek / Qwen / OpenAI / Ollama 等；密钥由用户补充）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0.2

# P3 推荐工作流
# RECOMMEND_TOP_K=5
# RECOMMEND_MAX_PARSE_RETRIES=1
# LINK_VECTOR_SIMILARITY_THRESHOLD=0.85

# P2 检索与评分（默认值见 app/config.py；两路权重之和必须为 1）
# RETRIEVAL_TOP_K=50
# RETRIEVAL_FUSION_RRF_K=60
# RETRIEVAL_BM25_WEIGHT=0.5
# RETRIEVAL_VECTOR_WEIGHT=0.5
# RETRIEVAL_VECTOR_QUERY_MULTIPLIER=4
# RETRIEVAL_VECTOR_MAX_DISTANCE=0.5
# SCORING_W_FUSION=0.4
# SCORING_W_COVERAGE=0.5
# SCORING_W_DIFFICULTY=0.05
# SCORING_W_TIME=0.05
# CHROMA_INGREDIENTS_COLLECTION=ingredients_docs

# P6.1 性能优化：推荐结果内存 TTL 缓存（秒；0=关闭）。重复/相似查询直接秒回，
# 仅缓存非降级结果；单进程 uvicorn 内生效，多 worker 时各进程独立缓存。
# RECOMMEND_CACHE_TTL_SECONDS=600
# RECOMMEND_CACHE_MAX_ENTRIES=256
# 启动时后台预热检索（BM25 语料 + Chroma），避免首个用户承担 30-60s 冷启动。
# WARMUP_ON_STARTUP=true

# P5 限流（slowapi；默认关闭，本地/测试/压测不打扰，生产开启）
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_STORAGE=memory              # memory | redis
# RATE_LIMIT_REDIS_URL=                  # storage=redis 时必填；生产多 worker 必配
# RATE_LIMIT_DEFAULT_PER_MINUTE=100
# RATE_LIMIT_RECOMMEND_PER_MINUTE=10
# RATE_LIMIT_FEEDBACK_PER_MINUTE=20

# P5 mock LLM（LLM_MOCK=true 时 get_llm_provider 返回确定性零网络 MockLLMProvider，
# 供 CI / k6 压测；真实 LLM 评测仍配 LLM_API_KEY 并设 LLM_MOCK=false）
# LLM_MOCK=false

# P5 反馈匿名指纹盐（生产必填；scripts/start.sh 强校验非空，禁止使用开发盐）
# FEEDBACK_SALT=

# P5 LangSmith 评测（可选；无 key 时 eval --trace 跳过）
# LANGSMITH_API_KEY=

# P6 部署（生产经 Caddy 反代；凭据只走 .env，禁止写死 compose）
# BEHIND_PROXY=true 时 FORWARDED_ALLOW_IPS 必填（逗号分隔 IP/CIDR，
# 必须与 Caddy 容器实际 IP 一致——compose 固定 172.28.0.10）
# BEHIND_PROXY=false
# FORWARDED_ALLOW_IPS=172.28.0.10
# ALLOWED_HOSTS=your-domain.com            # Host 白名单（逗号分隔；空 = 不校验，生产必填）
# DOCS_ENABLED=false                       # false → /docs、/openapi.json、/redoc 404（生产建议 false）
# SECURITY_HEADERS_ENABLED=true            # CSP / X-Frame-Options / nosniff / Referrer-Policy

# Docker 全栈（docker compose up -d --build 使用；强口令仅存 .env）
# MYSQL_DATABASE=ai_cooker
# MYSQL_USER=ai_cooker
# MYSQL_PASSWORD=<强口令，禁止默认值>
# MYSQL_ROOT_PASSWORD=<强口令，禁止默认值>
# REDIS_PASSWORD=<强口令，禁止默认值>
# CADDY_DOMAIN=your-domain.com             # 已解析到本机的域名（Caddy 自动 HTTPS）
# BACKUP_DIR=./backups                     # backup.sh 输出目录
# BACKUP_STOP_APP_ALLOWED=false            # --stop-app 停机窗口显式声明后才允许 true
