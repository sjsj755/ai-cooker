# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# uv cache
.uv-cache

# Environment secrets
.env

# 本地开发用 MySQL 实例（替代 docker-compose 时使用）
.localdb/

# 采集中间产物：JSON 落盘、断点状态、失败清单与 Chroma 持久化目录（不入库）
data/

# P6 备份产物（MySQL dump / Chroma tar / manifest）不入库
backups/

# 桌面环境临时桥接目录（截图等 QA 产物不入库）
.tmp_bridge/
